{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"rootDir": "../..",
		"outDir": "dist"
	},
	"include": ["src", "../../src/lib"],
	"exclude": [
		"../../src/lib/utils/cog-asset.ts",
		"../../src/lib/utils/host-detection.ts",
		"../../src/lib/utils/markdown-sql.ts",
		"../../src/lib/utils/stac-facets.ts",
		"../../src/lib/utils/stac-geoparquet.ts",
		"../../src/lib/utils/stac-pushdown.ts",
		"../../src/lib/utils/stac-source.ts",
		"../../src/lib/utils/stac.ts"
	]
}
