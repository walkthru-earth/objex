{
	"name": "@walkthru-earth/objex-utils",
	"version": "1.1.0",
	"description": "Pure TypeScript utilities from objex — WKB parser, GeoArrow builder, storage URL parser, file type registry",
	"author": "Youssef Harby <yharby@walkthru.earth>",
	"license": "CC-BY-4.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/walkthru-earth/objex.git",
		"directory": "packages/objex-utils"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsup"
	},
	"peerDependencies": {
		"apache-arrow": ">=14",
		"hyparquet": ">=1.25",
		"hyparquet-compressors": ">=1.1",
		"yaml": ">=2"
	},
	"peerDependenciesMeta": {
		"apache-arrow": {
			"optional": true
		},
		"hyparquet": {
			"optional": true
		},
		"hyparquet-compressors": {
			"optional": true
		},
		"yaml": {
			"optional": true
		}
	},
	"devDependencies": {
		"tsup": "^8.5.0",
		"typescript": "^5.9.3"
	}
}
