{
	"name": "@walkthru-earth/objex",
	"version": "1.3.1",
	"description": "Svelte 5 components and utilities for exploring geospatial object storage — S3, GCS, Azure, R2",
	"author": "Youssef Harby <yharby@walkthru.earth>",
	"license": "CC-BY-4.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/walkthru-earth/objex.git"
	},
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"import": "./dist/index.js"
		},
		"./storage": {
			"types": "./dist/storage/index.d.ts",
			"svelte": "./dist/storage/index.js",
			"import": "./dist/storage/index.js"
		},
		"./query": {
			"types": "./dist/query/engine.d.ts",
			"svelte": "./dist/query/engine.js",
			"import": "./dist/query/engine.js"
		},
		"./file-icons": {
			"types": "./dist/file-icons/index.d.ts",
			"svelte": "./dist/file-icons/index.js",
			"import": "./dist/file-icons/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"svelte": "./dist/types.js",
			"import": "./dist/types.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/CLAUDE.md",
		"!dist/assets"
	],
	"sideEffects": [
		"**/*.css"
	],
	"packageManager": "pnpm@10.30.1",
	"engines": {
		"node": ">=20",
		"pnpm": ">=10"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package -o dist && publint",
		"prepublishOnly": "pnpm run package",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome lint src/ packages/",
		"lint:fix": "biome lint --fix src/ packages/",
		"format": "biome format --write src/ packages/",
		"format:check": "biome format src/ packages/",
		"deadcode": "knip",
		"ci:publish": "pnpm run package && pnpm --filter @walkthru-earth/objex-utils run build && pnpm publish -r --access public --no-git-checks --provenance"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2",
		"svelte": "^5"
	},
	"peerDependenciesMeta": {
		"maplibre-gl": {
			"optional": true
		},
		"deck.gl": {
			"optional": true
		},
		"@deck.gl/core": {
			"optional": true
		},
		"@deck.gl/layers": {
			"optional": true
		},
		"@deck.gl/geo-layers": {
			"optional": true
		},
		"@deck.gl/mapbox": {
			"optional": true
		},
		"@duckdb/duckdb-wasm": {
			"optional": true
		},
		"apache-arrow": {
			"optional": true
		},
		"hyparquet": {
			"optional": true
		},
		"hyparquet-compressors": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.14",
		"@changesets/changelog-github": "^0.5.2",
		"@changesets/cli": "^2.31.0",
		"@fontsource/cairo": "^5.2.7",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^0.561.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"knip": "^6.12.2",
		"lefthook": "^2.1.6",
		"paneforge": "^1.0.2",
		"posthog-js": "^1.372.10",
		"publint": "^0.3.20",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.8",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.3"
	},
	"dependencies": {
		"@walkthru-earth/objex-utils": "workspace:*",
		"@babylonjs/core": "^8.56.2",
		"@babylonjs/loaders": "^8.56.2",
		"@carbonplan/zarr-layer": "^0.4.3",
		"@chunkd/middleware": "^11.3.0",
		"@chunkd/source": "^11.4.0",
		"@chunkd/source-http": "^11.4.0",
		"@codemirror/autocomplete": "^6.20.2",
		"@codemirror/commands": "^6.10.3",
		"@codemirror/lang-sql": "^6.10.0",
		"@codemirror/language": "^6.12.3",
		"@codemirror/state": "^6.6.0",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.42.1",
		"@deck.gl/core": "^9.3.2",
		"@deck.gl/geo-layers": "^9.3.2",
		"@deck.gl/layers": "^9.3.2",
		"@deck.gl/mapbox": "^9.3.2",
		"@deck.gl/mesh-layers": "^9.3.2",
		"@developmentseed/deck.gl-geotiff": "0.6.1",
		"@developmentseed/deck.gl-raster": "0.6.1",
		"@developmentseed/deck.gl-zarr": "0.6.1",
		"@developmentseed/epsg": "0.6.1",
		"@developmentseed/geotiff": "0.6.1",
		"@developmentseed/proj": "0.6.1",
		"@duckdb/duckdb-wasm": "1.33.1-dev53.0",
		"@geoarrow/deck.gl-layers": "^0.3.2",
		"@luma.gl/core": "^9.3.3",
		"@mapbox/vector-tile": "^2.0.4",
		"@milkdown/kit": "^7.20.0",
		"@milkdown/theme-nord": "^7.20.0",
		"@repeaterjs/repeater": "^3.0.6",
		"@zip.js/zip.js": "^2.8.26",
		"ansi_up": "^6.0.6",
		"apache-arrow": "^21.1.0",
		"aws4fetch": "^1.0.20",
		"chart.js": "^4.5.1",
		"deck.gl": "^9.3.2",
		"flatgeobuf": "^4.4.0",
		"hyparquet": "^1.25.7",
		"hyparquet-compressors": "^1.1.1",
		"lz-string": "^1.5.0",
		"maplibre-gl": "^5.24.0",
		"marked": "^17.0.6",
		"mermaid": "^11.14.0",
		"pbf": "^4.0.1",
		"pdfjs-dist": "^5.7.284",
		"pmtiles": "^4.4.1",
		"proj4": "^2.20.8",
		"shiki": "^3.23.0",
		"sql-formatter": "^15.7.3",
		"yaml": "^2.8.4",
		"zarrita": "^0.7.3"
	},
	"pnpm": {
		"overrides": {
			"zarrita": "^0.7.1"
		},
		"patchedDependencies": {
			"@developmentseed/deck.gl-geotiff@0.6.1": "patches/@developmentseed__deck.gl-geotiff@0.6.1.patch",
			"@developmentseed/deck.gl-raster@0.6.1": "patches/@developmentseed__deck.gl-raster@0.6.1.patch",
			"@carbonplan/zarr-layer@0.4.3": "patches/@carbonplan__zarr-layer@0.4.3.patch"
		}
	}
}
